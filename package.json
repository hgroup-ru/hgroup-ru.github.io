{
  "name": "hgroup-ru.github.io",
  "private": true,
  "scripts": {
    "audit:external-links": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/checkExternalReadingLinks.mts",
    "audit:local-cq": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/checkLocalChallengeQuestions.mts",
    "audit:local-cq-evidence": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/checkLocalChallengeQuestionAudits.mts",
    "audit:local-cq-states": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/checkLocalChallengeQuestionStates.mts",
    "build": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/build.mts",
    "build:ru": "npm run generate-product-data && npm run compile-plugin && docusaurus clear && docusaurus build --locale ru",
    "clear": "docusaurus clear",
    "compile-plugin": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/compilePlugin.mts",
    "docusaurus": "docusaurus",
    "format": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/finalizeExtrasTeachingCandidate.mts && npm run generate-product-data && eslint --fix . && prettier --write .",
    "generate-product-data": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/generateProductData.mts",
    "lint": "npm run lint:core && npm run audit:local-cq && npm run audit:local-cq-states && npm run audit:local-cq-evidence && npm run audit:external-links",
    "lint:core": "npm run generate-product-data && tsx --tsconfig ./scripts/tsconfig.json ./scripts/lint.mts",
    "prepare": "husky",
    "serve": "docusaurus serve",
    "start": "npm run generate-product-data && npm run compile-plugin && docusaurus start",
    "swizzle": "docusaurus swizzle",
    "update": "complete-cli update"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@mdx-js/react": "3.1.1",
    "complete-common": "2.29.0",
    "prism-react-renderer": "2.4.1",
    "raw-loader": "4.0.2",
    "react": "19.2.7",
    "react-circular-progressbar": "2.2.0",
    "react-dom": "19.2.7",
    "react-zoom-pan-pinch": "4.0.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "2.3.2",
    "complete-cli": "1.5.31",
    "complete-lint": "5.20.0",
    "complete-node": "17.0.2",
    "git-pull-run": "1.6.3",
    "glob": "13.0.6",
    "husky": "9.1.7",
    "prettier-plugin-sh": "0.18.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "webpack": "5.107.2"
  }
}
